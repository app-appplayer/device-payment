# The signing key. This is the whole point of the arrangement being asymmetric:
# the device holds the public half and cannot mint an authority, and neither can
# anyone who reads this repository. Regenerate your own with
# `dart run bin/mint.dart keygen` — which also rewrites src/service_pubkey.inc,
# so reflash the board afterwards or every voucher is refused.
embedded/locker_node/tools/mint_voucher/keys.json

# This device's own private key. A published device key is a device anyone can
# impersonate — the assertion it signs would prove nothing. Generated by the
# same `keygen`, which is therefore step zero of any build.
embedded/locker_node/src/device_privkey.inc

# The service's public half. Harmless on its own, but shipping half a pair
# reads as "this repository comes with a working key" and it does not. Both are
# generated by the same command, so both are absent until you run it.
embedded/locker_node/src/service_pubkey.inc

# What the service has seen from each device. Local bookkeeping, not contract.
embedded/locker_node/tools/mint_voucher/counters.json

# Build output. Arduino copies the entire sketch folder in here, key and all.
embedded/locker_node/build/
nodes/.dart_tool/
**/.dart_tool/
.dart_tool/

# Host harness binaries — built from the same sources in one command.
embedded/locker_node/host/*_host
*.o

.DS_Store
